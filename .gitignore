# Secrets et config locale (ne jamais committer)
config/*.local.php
config/*.local.*.php
!config/*.local.example.php

# Dépendances PHP
/vendor/*
!/vendor/.htaccess

# Logs locaux
logs/*
!logs/.htaccess

# --- Docs : uniquement les PDF livrables sous docs/rapport_ECF/ ---
docs/**
!docs/.htaccess
!docs/rapport_ECF/
!docs/rapport_ECF/**
# Ne pas versionner les extractions / brouillons locaux dans ce dossier
docs/rapport_ECF/**/*_extract.txt
docs/rapport_ECF/**/_audit.txt

# --- Scripts : sync Mongo + protection HTTP ---
scripts/**
!scripts/.htaccess
!scripts/sync_stats_mongo.php

# Archives CSS locales (backups hors versionnement)
public/css/archive/

# Swagger UI local (doc API — ne pas committer)
public/swagger/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
